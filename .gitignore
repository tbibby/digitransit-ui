# macOS Finder metadata
.DS_Store

# Main app webpack build output (see webpack.config.babel.js)
_static
npm-debug.log
filesizes.html
stats.json
manifest.json

# Installed dependencies (yarn/npm)
node_modules

# various files
test/credentials.json
test/binaries
*.swp
.idea
.vscode/*
!.vscode/launch.json
!.vscode/tasks.json
*.iml
*~
selenium-debug.log
tags
sessions/
run*.sh

# Relay-compiler generated GraphQL artifacts (main app)
app/**/__generated__
utils/**/__generated__

# Rollup build output (see config/rollup.config.js). digitransit-search-util-
# query-utils's relay.artifactDirectory (./lib/__generated__) always nests
# generated GraphQL artifacts inside lib/, so this already covers them too.
digitransit-util/packages/**/lib
digitransit-search-util/packages/**/lib
digitransit-component/packages/**/lib
digitransit-store/packages/**/lib

# Rollup build output (see config/rollup.config.js)
yarn-error.log
dump.rdb

# Nx's local task-graph/build cache (used by `lerna run build`/`watch` via
# nx.json's task pipeline) - always safe to delete, regenerated on demand.
.nx

# Lerna's debug log, written when a lerna command errors out.
lerna-debug.log

# JSON summary written by `lerna publish --summary-file` (used by the
# publish-npm CI job); only produced when actually publishing.
lerna-publish-summary.json

# Yarn Berry (zero-installs) cache - only keep the config/tooling subdirs, not the
# downloaded package cache itself
.yarn/*
!.yarn/patches
!.yarn/releases
!.yarn/plugins
!.yarn/sdks
!.yarn/versions
.pnp.*
.npmrc

# NTA-internal additions (not part of upstream digitransit-ui)
# Project-management/planning notes: internal-only, not part of the software
# itself, so excluded from the AGPL Corresponding Source obligation - see
# RESEARCH.md's licensing section for the reasoning.
CONTEXT.md
TASKS.md
TECHNICAL-IMPLEMENTATION.md
RESEARCH.md
RESEARCH-*.md

# Real secrets (API keys, subscription tokens, etc). digitransit-ui reads
# these from process.env at runtime, never hardcodes them in committed
# config - keep it that way, and never commit a real .env here.
.env
.env.*
!.env.example
